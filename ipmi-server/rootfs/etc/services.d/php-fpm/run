#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community Add-on: IPMI server
# Runs the PHP-FPM daemon
# ==============================================================================

bashio::log.info "Starting PHP-FPM..."

# Persist saved BMC profiles in the add-on data directory.
mkdir -p /data
if [[ ! -f /data/ipmi-servers.json ]]; then
    printf '%s\n' '{"servers":[]}' > /data/ipmi-servers.json
fi
chown nginx:nginx /data/ipmi-servers.json
chmod 600 /data/ipmi-servers.json

# Drop stale compiled container (e.g. copied from a previous build) so new
# controller constructor deps are picked up after code changes.
rm -rf /app/var/cache/*

# Drop a stale socket left behind after a crash so FPM can bind again.
rm -f /run/php-fpm.sock

# Avoid filling the container with core dumps (e.g. under /app/public).
ulimit -c 0

#/usr/sbin/php-fpm* -F
exec php-fpm84 --nodaemonize
